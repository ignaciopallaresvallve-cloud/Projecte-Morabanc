# MoraBanc Office Store — variables d'entorn de producció.
#
# Copiar a `.env.production` (mateix directori que package.json) i
# omplir amb els valors reals ABANS d'executar `npm run build`: les
# variables NEXT_PUBLIC_ Next.js les incrusta al codi del navegador
# durant la compilació, no en cada arrencada del servidor. Les variables
# sense aquest prefix (RESEND_*) són només de servidor.
#
# NO versionar `.env.production` amb els valors reals (afegit a
# .gitignore igual que .env.local).

# Supabase — Project Settings > API al dashboard de Supabase.
# Aquesta app només necessita la clau anon (pública): tota l'escriptura
# privilegiada es fa via RLS + funcions RPC "security definer", no amb
# una service role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública real del lloc en producció (per a metadata, sitemap.xml i
# robots.txt). Sense això, cauen per defecte a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://office-store.morabanc.ad

# Resend — enviament dels correus de notificació quan un admin aprova o
# rebutja una sol·licitud especial (>3 unitats). Variable NOMÉS de
# servidor (sense prefix NEXT_PUBLIC_). Si es deixa buida, l'app segueix
# funcionant amb normalitat: l'aprovació/rebuig es completa igualment,
# simplement no s'envia el correu.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
