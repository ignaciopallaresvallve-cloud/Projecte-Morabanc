<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoraBanc Office Store — reverse proxy IIS hacia el proceso Node (PM2).

  Requiere los módulos IIS "URL Rewrite" y "Application Request Routing"
  (ARR) instalados, y el proxy habilitado a nivel de servidor:
  IIS Manager > (nodo del servidor) > Application Request Routing Cache
  > Server Proxy Settings > Enable proxy.

  Copiar este fichero como `web.config` en la raíz física del sitio IIS
  (ver docs/deployment.md, sección 5).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Todo el tráfico HTTP (puerto 80) se redirige a HTTPS. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Todo el tráfico HTTPS se reenvía (proxy, no redirect) al
             proceso Node local gestionado por PM2. -->
        <rule name="Reverse Proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>

      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
      </allowedServerVariables>
    </rewrite>

    <!-- No hacen falta ficheros estáticos servidos directamente por
         IIS: todo pasa por el proxy hacia Node, que ya sirve /public y
         /_next/static. -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
