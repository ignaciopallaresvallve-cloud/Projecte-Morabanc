# Supabase — copiar este archivo a .env.local y rellenar con los valores
# del proyecto (Project Settings > API en el dashboard de Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — envío de correos de notificación (aprobación/rechazo de
# solicitudes especiales). Solo de servidor: sin prefijo NEXT_PUBLIC_,
# nunca se incrusta en el bundle del navegador. Opcional en local: si se
# deja vacío, la app sigue funcionando y simplemente no se envían correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
